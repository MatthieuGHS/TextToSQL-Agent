# Copier ce fichier en .env et renseigner les valeurs.
# Le .env est ignoré par Git — ne jamais y committer de clé.

# Clé API Anthropic (fournie par le client)
ANTHROPIC_API_KEY=

# Chemin de la base DuckDB générée par l'ETL
DB_PATH=data/mmm.duckdb

# Modèle par défaut (claude-sonnet-5 | claude-opus-5)
MODEL_ID=claude-sonnet-5
