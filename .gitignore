# === Données client — ne jamais committer ===
# Refus par défaut, quel que soit l'emplacement du fichier.
data/raw/
*.csv
*.xlsx
*.duckdb
*.db
*.sqlite

# Exception : les jeux d'essai des tests, inventés et neutres par construction.
# Sans cette ligne, le harnais d'évaluation (E5) verrait ses fichiers de référence
# ignorés en silence — un fichier absent du dépôt sans qu'aucun message ne le dise.
!tests/**/*.csv

# Le harnais d'évaluation archive chaque exécution — question, SQL, réponse verbatim —
# et en tire des rapports chiffrés. Ce sont des données client au même titre que la base,
# et rien au-dessus ne les couvrait : ce sont des `.json` et des `.md` dans `data/`.
data/eval/

# === Documents contenant des chiffres client ===
# Seul `docs/prive/` est exclu. Le reste de `docs/` est versionné : décisions de
# conception et rationnel de schéma, écrits sans aucune valeur issue des données.
docs/prive/
*.pdf

# === Secrets ===
.env
.env.local
*.key

# === Python ===
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# === Interface ===
# `package-lock.json` est versionné, lui : c'est ce qui rend la construction de l'image
# reproductible. Le reste se régénère.
web/node_modules/
web/dist/
web/.vite/

# === Outils ===
.claude/
.vscode/
.idea/
.DS_Store
