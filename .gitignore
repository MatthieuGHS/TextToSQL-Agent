# === Données client — ne jamais committer ===
# Refus par défaut, quel que soit l'emplacement du fichier.
data/raw/
*.csv
*.xlsx
*.duckdb
*.db
*.sqlite

# Exception : les jeux d'essai des tests, inventés et neutres par construction.
# Sans cette ligne, le harnais d'évaluation (E5) verrait ses fichiers de référence
# ignorés en silence — un fichier absent du dépôt sans qu'aucun message ne le dise.
!tests/**/*.csv

# === Documents contenant des chiffres client ===
# Seul `docs/prive/` est exclu. Le reste de `docs/` est versionné : décisions de
# conception et rationnel de schéma, écrits sans aucune valeur issue des données.
docs/prive/
*.pdf

# === Secrets ===
.env
.env.local
*.key

# === Python ===
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# === Outils ===
.claude/
.vscode/
.idea/
.DS_Store
